#!/usr/bin/env bash
# Compare two saved criterion baselines and store the report.
#
# Usage: bench-compare <base> <head>
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "usage: $(basename "$0") <base> <head>" >&2
    exit 1
fi

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

base="$1"
head="$2"

cargo bench -- --load-baseline "$head" --baseline "$base"
